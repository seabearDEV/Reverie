{
  "about": "A chain lists a name the user flagged globally, and the project aliases that name to its own command (#279, chain member).",
  "stores": {
    "project": {
      "entries": {
        "ch": "fl",
        "a": "echo RVM1x >> \"$RLOG\""
      },
      "aliases": {
        "fl": "a"
      }
    },
    "global": {
      "entries": {
        "fl": "echo RVM2x >> \"$RLOG\""
      },
      "confirm": {
        "fl": true
      }
    }
  },
  "markers": {
