{
  "about": "A :- default body runs a flagged command when its key is missing: the gate walk looks inside the default (#158).",
  "stores": {
    "project": {
      "entries": {
        "p": "echo RVM1x ${nope:-$(fl)} >> \"$RLOG\""
      }
    },
    "global": {
      "entries": {
        "fl": "echo RVM2x >> \"$RLOG\""
      },
      "confirm": {
        "fl": true
      }
    }
  },
  "markers": {
    "1": [
      "project",
      "p"
    ],
    "2": [
      "global",
      "fl"
    ]
  },
  "invocations": [
    {
      "surface": "cli",
      "cwd": "proj",
      "kind": "run",
      "keys": [
        "p"
      ],
      "global": false,
      "chain": false,
      "yes": false,
      "mode": "json"
    },
    {
      "surface": "mcp",
      "cwd": "proj",
      "tool": "reverie_run",
      "args": {
        "key": "p"
      }
    }
  ]
}
